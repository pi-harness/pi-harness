{
  "id": "auto-mode",
  "packageName": "@pi-harness/plugin-auto-mode",
  "version": "0.1.30",
  "name": "Auto Mode",
  "description": "在受控策略下执行 argv 命令：拒绝 shell 包装，危险操作要求确认。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "security",
    "label": "安全"
  },
  "capabilities": ["reads-files", "runs-commands"],
  "hooks": ["argv 执行", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-auto-mode",
    "config": {
      "mode": "safe",
      "timeoutMs": 30000
    }
  }
}
