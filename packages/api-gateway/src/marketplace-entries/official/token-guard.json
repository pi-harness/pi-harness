{
  "id": "token-guard",
  "packageName": "@pi-harness/plugin-token-guard",
  "version": "0.1.29",
  "name": "Token Guard",
  "description": "Use descriptor-safe monitoring to issue at most one abort request per run when a context percentage or billed run-token budget is reached, with bounded errors and a cached normalized panel.",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "observability",
    "label": "可观测性"
  },
  "capabilities": ["read-only", "session-data"],
  "hooks": ["Pi session lifecycle", "active runtime abort", "session usage and statistics", "plugin UI"],
  "profile": {
    "name": "@pi-harness/plugin-token-guard",
    "config": {
      "maxPercent": 90,
      "maxRunTokens": 0
    }
  }
}
