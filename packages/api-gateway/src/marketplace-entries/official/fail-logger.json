{
  "id": "fail-logger",
  "packageName": "@pi-harness/plugin-fail-logger",
  "version": "0.1.29",
  "name": "Failure Logger",
  "description": "汇总插件错误、agent 失败和非主动中断的压缩失败，只保留安全的摘要和次数，不留原始载荷。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "observability",
    "label": "可观测性"
  },
  "capabilities": ["read-only"],
  "hooks": ["插件错误", "运行结束", "压缩结束", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-fail-logger",
    "config": {}
  }
}
