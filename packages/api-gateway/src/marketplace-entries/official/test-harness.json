{
  "id": "test-harness",
  "packageName": "@pi-harness/plugin-test-harness",
  "version": "0.1.31",
  "name": "Test Harness",
  "description": "运行工作区里五个固定名字的 npm 脚本，返回真实状态和清理过的 12 KiB 输出尾部；超时可配置，取消时清理整棵进程树。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "developer",
    "label": "开发工具"
  },
  "capabilities": ["runs-commands"],
  "hooks": ["项目验证工具", "工作区 npm 脚本", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-test-harness",
    "config": {
      "timeoutMs": 120000
    }
  }
}
