{
  "id": "sql-lens",
  "packageName": "@pi-harness/plugin-sql-lens",
  "version": "0.1.29",
  "name": "SQL Lens",
  "description": "查看工作区内的 SQLite 数据库：一次一条只读语句，结果有上限，检查符号链接与文件替换，超时和取消都会收尾。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "developer",
    "label": "开发工具"
  },
  "capabilities": ["reads-files", "runs-commands"],
  "hooks": ["SQL 只读工具", "工作区 SQLite 文件", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-sql-lens",
    "config": {
      "timeoutMs": 5000
    }
  }
}
