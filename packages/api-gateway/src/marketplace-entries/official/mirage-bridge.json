{
  "id": "mirage-bridge",
  "packageName": "@pi-harness/plugin-mirage-bridge",
  "version": "0.1.30",
  "name": "Mirage Bridge",
  "description": "把 Pi Harness 接到官方 Mirage 虚拟终端 CLI，不额外引入第二个宿主 shell。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "developer",
    "label": "开发工具"
  },
  "capabilities": ["runs-commands"],
  "hooks": ["Mirage CLI", "argv 执行", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-mirage-bridge",
    "config": {
      "executable": "mirage",
      "workspaceId": ""
    }
  }
}
