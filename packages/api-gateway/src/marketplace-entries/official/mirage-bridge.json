{
  "id": "mirage-bridge",
  "packageName": "@pi-harness/plugin-mirage-bridge",
  "version": "0.1.29",
  "name": "Mirage Bridge",
  "description": "Connect Pi Harness to the official Mirage virtual-terminal CLI without adding a second host shell.",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "tools",
    "label": "工具"
  },
  "capabilities": ["runs-commands"],
  "hooks": ["Mirage CLI", "argv execution", "plugin UI"],
  "profile": {
    "name": "@pi-harness/plugin-mirage-bridge",
    "config": {
      "executable": "mirage",
      "workspaceId": ""
    }
  }
}
