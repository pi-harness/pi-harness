{
  "id": "cost-meter",
  "packageName": "@pi-harness/plugin-cost-meter",
  "version": "0.1.31",
  "name": "Cost Meter",
  "description": "把运行时上报的费用按 UTC 天累计到本地账本，提供会话快照和可选的日预算提醒；不猜测模型价格。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "observability",
    "label": "可观测性"
  },
  "capabilities": ["session-data", "reads-files", "writes-files"],
  "hooks": ["运行结束", "费用报告工具", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-cost-meter",
    "config": {
      "dailyBudget": 0,
      "maxEntries": 365
    }
  }
}
