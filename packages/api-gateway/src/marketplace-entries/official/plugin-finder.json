{
  "id": "plugin-finder",
  "packageName": "@pi-harness/plugin-plugin-finder",
  "version": "0.1.32",
  "name": "Plugin Finder",
  "description": "在配置好的 npm 兼容 registry 里搜索 Pi 插件，查询有上限，安装交回控制台完成。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "discovery",
    "label": "发现与生态"
  },
  "capabilities": ["network-access"],
  "hooks": ["npm registry", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-plugin-finder",
    "config": {
      "keyword": "pi-harness"
    }
  }
}
