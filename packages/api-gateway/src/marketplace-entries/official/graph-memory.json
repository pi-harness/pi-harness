{
  "id": "graph-memory",
  "packageName": "@pi-harness/plugin-graph-memory",
  "version": "0.1.32",
  "name": "Graph Memory",
  "description": "把任务、技能、事件存成带类型的节点和有向关系，落盘加锁，可跨会话检索。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "context",
    "label": "上下文管理"
  },
  "capabilities": ["reads-files", "writes-files"],
  "hooks": ["图记忆工具", "本地图文件", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-graph-memory",
    "config": {
      "fileName": "graph-memory.json",
      "maxNodes": 2000,
      "maxRelations": 5000
    }
  }
}
