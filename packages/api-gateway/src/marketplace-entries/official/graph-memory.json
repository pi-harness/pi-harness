{
  "id": "graph-memory",
  "packageName": "@pi-harness/core/plugins/graph-memory",
  "version": "0.1.27",
  "name": "Graph Memory",
  "description": "Store bounded typed task, skill, and event nodes with validated directed relations, atomic locked persistence, and inspectable cross-session search.",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "memory",
    "label": "记忆与上下文"
  },
  "capabilities": ["bounded typed nodes", "validated directed relations", "ranked graph search", "atomic locked persistence"],
  "hooks": ["graph memory tools", "local graph file", "plugin UI"],
  "profile": {
    "name": "@pi-harness/core/plugins/graph-memory",
    "config": {
      "fileName": "graph-memory.json",
      "maxNodes": 2000,
      "maxRelations": 5000
    }
  }
