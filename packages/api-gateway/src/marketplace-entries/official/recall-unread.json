  "source": "official",
  "status": "verified",
  "category": {
    "id": "workflow",
    "label": "工作流"
  },
  "capabilities": ["read-only", "session-data", "reads-files"],
  "hooks": ["未读回溯工具", "原生会话存储", "当前会话管理器", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-recall-unread",
    "config": {}
  }
}
