  "name": "History Compressor",
  "description": "Compact the current Pi session automatically when context usage approaches a configured threshold.",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
