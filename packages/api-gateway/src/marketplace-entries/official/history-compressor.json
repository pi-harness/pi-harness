{
  "id": "history-compressor",
  "packageName": "@pi-harness/plugin-history-compressor",
  "version": "0.1.30",
  "name": "History Compressor",
  "description": "上下文占用接近设定阈值时，自动压缩当前 Pi 会话。",
  "author": "Pi Harness",
  "repository": "https://github.com/pi-harness/pi-harness",
  "license": "MIT",
  "source": "official",
  "status": "verified",
  "category": {
    "id": "context",
    "label": "上下文管理"
  },
  "capabilities": ["read-only", "session-data"],
  "hooks": ["运行结束", "上下文用量", "插件面板"],
  "profile": {
    "name": "@pi-harness/plugin-history-compressor",
    "config": {
      "enabled": true,
      "thresholdPercent": 85
    }
  }
}
