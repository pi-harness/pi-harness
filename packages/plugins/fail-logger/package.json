{
  "name": "@pi-harness/plugin-fail-logger",
  "version": "0.1.28",
  "description": "Aggregate bounded extension, Agent, and non-aborted compaction failures through descriptor-safe event inspection, safe diagnostic summaries, and occurrence counts without retaining full payloads.",
  "keywords": [
    "cordis",
    "pi-harness",
    "pi-harness-plugin",
    "plugin"
  ],
  "homepage": "https://github.com/pi-harness/pi-harness/tree/main/packages/plugins/fail-logger#readme",
  "bugs": {
    "url": "https://github.com/pi-harness/pi-harness/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-harness/pi-harness.git",
    "directory": "packages/plugins/fail-logger"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@pi-harness/plugin-api": "^0.1.27"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
