{
  "name": "@pi-harness/core",
  "version": "0.1.5",
  "description": "Cordis boot and Pi runtime plugins for Pi Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-harness/pi-harness.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pi-harness/pi-harness#readme",
  "bugs": {
    "url": "https://github.com/pi-harness/pi-harness/issues"
  },
  "files": [
    "dist",
    "profiles"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
