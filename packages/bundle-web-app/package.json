{
  "name": "@pi-harness/web-app",
  "version": "0.1.73",
  "private": true,
  "description": "Patchable Web application bundle for Pi Harness",
  "homepage": "https://github.com/pi-harness/pi-harness#readme",
  "bugs": {
    "url": "https://github.com/pi-harness/pi-harness/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-harness/pi-harness.git",
    "directory": "packages/bundle-web-app"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
