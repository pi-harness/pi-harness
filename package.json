{
  "name": "@pi-harness/pi-harness",
  "version": "0.1.10",
  "homepage": "https://github.com/pi-harness/pi-harness#readme",
  "bugs": {
    "url": "https://github.com/pi-harness/pi-harness/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-harness/pi-harness.git"
  },
  "bin": {
    "pi-harness": "./apps/web/server-dist/bin.js",
    "pih": "./packages/cli/dist/bin.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "files": [
    "apps/web",
    "packages"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w @pi-harness/core && npm run build -w @pi-harness/plugin-hello && npm run build -w @pi-harness/cli && npm run build -w @pi-harness/host-webserver && npm run build -w @pi-harness/api-gateway && npm run build -w @pi-harness/client-web && npm run build -w @pi-harness/web-app && npm run build -w @pi-harness/web",
    "build:web": "npm run build -w @pi-harness/core && npm run build -w @pi-harness/host-webserver && npm run build -w @pi-harness/api-gateway && npm run build -w @pi-harness/client-web && npm run build -w @pi-harness/web-app && npm run build -w @pi-harness/web",
    "web": "npm run build:web && node apps/web/server-dist/bin.js",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "prepack": "npm run build:web",
    "test:package": "node scripts/test-packed-package.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "typecheck": "npm run typecheck -w @pi-harness/core && npm run typecheck -w @pi-harness/plugin-hello && npm run typecheck -w @pi-harness/cli && npm run typecheck -w @pi-harness/host-webserver && npm run typecheck -w @pi-harness/api-gateway && npm run typecheck -w @pi-harness/client-web && npm run typecheck -w @pi-harness/web-app && npm run typecheck -w @pi-harness/web"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@pi-harness/api-gateway": "0.1.10",
    "@pi-harness/cli": "0.1.10",
    "@pi-harness/core": "0.1.10",
    "@pi-harness/host-webserver": "0.1.10",
    "@pi-harness/web-app": "0.1.10",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "bundledDependencies": [
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@pi-harness/api-gateway",
    "@pi-harness/cli",
    "@pi-harness/core",
    "@pi-harness/host-webserver",
    "@pi-harness/web-app"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
