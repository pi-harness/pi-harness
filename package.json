{
  "name": "pi-harness-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build -w @pi-harness/core && npm run build -w @pi-harness/cli",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @pi-harness/core && npm run typecheck -w @pi-harness/cli"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.9"
  }
}
