{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Harness marketplace entry",
  "type": "object",
  "required": [
    "id",
    "packageName",
    "version",
    "name",
    "description",
    "author",
    "repository",
    "license",
    "source",
    "status",
    "capabilities",
    "hooks",
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "packageName": { "type": "string", "pattern": "^(?:@[a-z0-9._~-]+/)?[a-z0-9._~-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1 },
    "source": { "enum": ["official", "community"] },
    "status": { "enum": ["verified", "experimental"] },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "hooks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "profile": {
      "type": "object",
      "required": ["name", "config"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "config": { "type": "object" } }
    }
  }
}
